@model List<EcomGalaxy.Domain.Models.Product.Category>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Categories</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: #1a1a1a;
            font-family: inherit;
            min-height: 100vh;
            padding: 40px 20px;
            color: #f0f0f0;
        }

        .page {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        /* Header row */
        .page-title {
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #555;
            font-weight: 500;
            margin-bottom: 4px;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
        }

        .page-heading {
            font-size: 28px;
            font-weight: 500;
            color: #f0f0f0;
        }

        /* Search + Add row */
        .toolbar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .search-bar {
            display: flex;
            align-items: center;
            flex: 1;
            min-width: 220px;
            background: #242424;
            border: 1px solid #333;
            border-radius: 10px;
            overflow: hidden;
            transition: border-color 0.2s;
        }

            .search-bar:focus-within {
                border-color: darkorange;
            }

        .search-input {
            flex: 1;
            padding: 11px 16px;
            background: none;
            border: none;
            color: #f0f0f0;
            font-family: inherit;
            font-size: 14px;
            outline: none;
        }

            .search-input::placeholder {
                color: #555;
            }

        .search-button {
            padding: 11px 16px;
            background: none;
            border: none;
            color: #555;
            cursor: pointer;
            font-size: 15px;
            transition: color 0.2s;
        }

            .search-button:hover {
                color: darkorange;
            }

        .btn-add {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 20px;
            background: none;
            border: 1px solid darkorange;
            border-radius: 10px;
            color: darkorange;
            font-family: inherit;
            font-size: 13px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.25s ease;
            white-space: nowrap;
        }

            .btn-add:hover {
                background: darkorange;
                color: white;
            }

        /* Grid */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 16px;
        }

        /* Category card */
        .card {
            background: #242424;
            border: 1px solid #333;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
            display: flex;
            flex-direction: column;
            text-decoration: none;
            color: inherit;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 28px rgba(0,0,0,0.5);
                border-color: #444;
            }

        .image-container {
            width: 100%;
            height: 180px;
            overflow: hidden;
            background: #2e2e2e;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .card:hover .product-image {
            transform: scale(1.04);
        }

        .card-body {
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            flex: 1;
        }

        .category-name {
            font-size: 15px;
            font-weight: 500;
            color: #f0f0f0;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .btn-details {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
            border-radius: 8px;
            font-family: inherit;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.25s ease;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border: 1px solid #444;
            background: none;
            color: #888;
            text-decoration: none;
            width: 100%;
        }

            .btn-details:hover {
                border-color: darkorange;
                color: darkorange;
                background: #2a1a00;
            }

        /* Empty state */
        .empty-state {
            background: #242424;
            border: 1px solid #333;
            border-radius: 12px;
            padding: 80px 40px;
            text-align: center;
            color: #555;
            font-size: 16px;
            grid-column: 1 / -1;
        }

        @@media (max-width: 500px) {
            .grid {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="page-title">EcomGalaxy</div>

        <div class="page-header">
            <div class="page-heading">Manage Categories</div>
        </div>

        <!-- Toolbar -->
        <div class="toolbar">
            <div class="search-bar">
                <input type="text" id="search-input" class="search-input" placeholder="Search categories...">
                <button class="search-button"><i class="fas fa-search"></i></button>
            </div>
            <a asp-action="AddCategory" asp-controller="Category" class="btn-add">
                <i class="fas fa-plus"></i> Add Category
            </a>
        </div>

        <!-- Grid -->
        <div class="grid" id="category-grid">
            @foreach (var category in Model)
            {
                <div class="card" data-name="@category.Name">
                    <div class="image-container">
                        <img src="/images/@category.CategoryImage"
                             alt="@category.Name"
                             class="product-image">
                    </div>
                    <div class="card-body">
                        <div class="category-name">@category.Name</div>
                        <a asp-action="CategoryDetails"
                           asp-controller="Category"
                           asp-route-id="@category.Id"
                           class="btn-details">
                            Details →
                        </a>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="empty-state">No categories found.</div>
            }
        </div>
    </div>

    <script>
        document.getElementById('search-input').addEventListener('input', function () {
            const val = this.value.toLowerCase();
            document.querySelectorAll('#category-grid .card').forEach(card => {
                const name = card.getAttribute('data-name').toLowerCase();
                card.style.display = name.includes(val) || val === '' ? '' : 'none';
            });
        });
    </script>
</body>
</html>
