@model EcomGalaxy.ViewModel.PagedResult<EcomGalaxy.ViewModel.Product.ProductViewModel>
@{
    ViewBag.Title = "My Store";
    Layout = "~/Views/Shared/_MyLayout.cshtml";

    var currentSearch = Context.Request.Query["search"].ToString();
}

<style>
    :root {
        --accent: #f97316;
        --text: #f0f0f0;
        --muted: #777;
        --surface: #1a1a1a;
        --surface2: #222;
        --border: #2a2a2a;
        --radius: 12px;
        --trans: .22s cubic-bezier(.4,0,.2,1);
        --font-head: 'Bebas Neue', sans-serif;
        --font-body: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
    }

    /* ── PAGE HEADER ── */
    .page-header {
        padding: 48px 28px 24px;
        max-width: 1300px;
        margin: 0 auto;
    }

        .page-header .eyebrow {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--accent);
            display: block;
            margin-bottom: 8px;
        }

    .header-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .page-header h1 {
        font-family: var(--font-head);
        font-size: clamp(36px, 5vw, 64px);
        letter-spacing: 2px;
        color: var(--text);
        margin: 0 0 6px;
        line-height: 1;
    }

    .page-header p {
        font-size: 14px;
        color: var(--muted);
        margin: 0;
    }

    /* ── ADD PRODUCT BUTTON ── */
    .btn-add-product {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 22px;
        background: var(--accent);
        color: #fff;
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 600;
        border-radius: var(--radius);
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
        transition: background var(--trans), transform var(--trans), box-shadow var(--trans);
    }

        .btn-add-product:hover {
            background: #e8660a;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(249,115,22,.3);
        }

        .btn-add-product:active {
            transform: translateY(0);
        }

    /* ── TOOLBAR ── */
    .seller-toolbar {
        position: sticky;
        top: 64px;
        z-index: 100;
        background: rgba(10,10,10,.9);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border);
        padding: 12px 28px;
    }

    .seller-toolbar-inner {
        max-width: 1300px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .search-wrap {
        display: flex;
        align-items: center;
        flex: 1;
        max-width: 420px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        transition: border-color var(--trans);
    }

        .search-wrap:focus-within {
            border-color: var(--accent);
        }

        .search-wrap i {
            padding: 0 12px;
            color: var(--muted);
            font-size: 13px;
            flex-shrink: 0;
            pointer-events: none;
        }

        .search-wrap input {
            flex: 1;
            background: none;
            border: none;
            outline: none;
            color: var(--text);
            font-family: var(--font-body);
            font-size: 13px;
            padding: 10px 12px 10px 0;
        }

            .search-wrap input::placeholder {
                color: var(--muted);
            }

    .seller-count {
        margin-left: auto;
        font-size: 12px;
        color: var(--muted);
    }

        .seller-count b {
            color: var(--text);
        }

    /* ── GRID ── */
    .seller-shop-wrap {
        max-width: 1300px;
        margin: 0 auto;
        padding: 28px 28px 40px;
    }

    .seller-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 20px;
    }

    .seller-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: border-color var(--trans), transform var(--trans), box-shadow var(--trans);
        animation: cardIn .45s ease both;
    }

        .seller-card:hover {
            border-color: rgba(249,115,22,.35);
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0,0,0,.45);
        }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .seller-card:nth-child(1) {
        animation-delay: .03s
    }

    .seller-card:nth-child(2) {
        animation-delay: .06s
    }

    .seller-card:nth-child(3) {
        animation-delay: .09s
    }

    .seller-card:nth-child(4) {
        animation-delay: .12s
    }

    .seller-card:nth-child(5) {
        animation-delay: .15s
    }

    .seller-card:nth-child(6) {
        animation-delay: .18s
    }

    .seller-img-wrap {
        position: relative;
        width: 100%;
        padding-top: 75%;
        overflow: hidden;
        background: var(--surface2);
    }

        .seller-img-wrap img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .5s cubic-bezier(.4,0,.2,1);
        }

    .seller-card:hover .seller-img-wrap img {
        transform: scale(1.06);
    }

    .seller-body {
        padding: 16px 16px 0;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .seller-name {
        font-size: 15px;
        font-weight: 600;
        color: var(--text);
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .seller-desc {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
    }

    .seller-price {
        font-size: 20px;
        font-weight: 700;
        color: var(--text);
        margin-top: auto;
        padding-top: 10px;
    }

        .seller-price span {
            font-size: 12px;
            font-weight: 400;
            color: var(--muted);
            margin-left: 3px;
        }

    .seller-footer {
        padding: 12px 16px 16px;
    }

    .btn-manage {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        height: 38px;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 9px;
        color: var(--text);
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background var(--trans), border-color var(--trans), color var(--trans), transform var(--trans);
    }

        .btn-manage:hover {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
            transform: translateY(-1px);
        }

        .btn-manage:active {
            transform: translateY(0);
        }

    /* Empty state */
    .seller-empty {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 80px 20px;
        gap: 16px;
        grid-column: 1 / -1;
    }

        .seller-empty i {
            font-size: 48px;
            color: var(--border);
        }

        .seller-empty h3 {
            font-family: var(--font-head);
            font-size: 28px;
            letter-spacing: 1px;
            color: var(--muted);
        }

        .seller-empty p {
            font-size: 13px;
            color: var(--muted);
        }

        .seller-empty a {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 24px;
            background: var(--accent);
            color: #fff;
            border-radius: var(--radius);
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: background var(--trans);
        }

            .seller-empty a:hover {
                background: #e8660a;
            }

    /* ── PAGINATION ── */
    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 24px 0 60px;
        border-top: 1px solid var(--border);
        margin-top: 8px;
    }

    .pagination-info {
        font-size: 12px;
        color: var(--muted);
    }

    .pagination-controls {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        height: 36px;
        padding: 0 10px;
        border-radius: 8px;
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        border: 1px solid var(--border);
        background: none;
        color: var(--muted);
        transition: border-color var(--trans), color var(--trans), background var(--trans);
    }

        .page-btn:hover:not(.disabled):not(.active) {
            border-color: var(--accent);
            color: var(--accent);
        }

        .page-btn.active {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
            pointer-events: none;
        }

        .page-btn.disabled {
            opacity: 0.3;
            pointer-events: none;
        }

    .page-ellipsis {
        font-size: 13px;
        color: var(--muted);
        padding: 0 3px;
    }

    @@media (max-width: 768px) {
        .seller-toolbar {
            padding: 10px 16px;
        }

        .seller-shop-wrap {
            padding: 20px 16px 40px;
        }

        .seller-grid {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px;
        }

        .seller-body {
            padding: 12px 12px 0;
        }

        .seller-footer {
            padding: 10px 12px 12px;
        }

        .search-wrap {
            max-width: 100%;
        }

        .seller-count {
            display: none;
        }

        .pagination-bar {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 400px) {
        .seller-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<!-- ── PAGE HEADER ── -->
<div class="page-header">
    <span class="eyebrow">Seller Dashboard</span>
    <div class="header-row">
        <div>
            <h1>My Store</h1>
            <p>Manage your listed products, update details, or add new items.</p>
        </div>
        <a asp-action="AddProduct" asp-controller="Product" class="btn-add-product">
            <i class="fa-solid fa-plus"></i> Add Product
        </a>
    </div>
</div>

<!-- ── TOOLBAR ── -->
<div class="seller-toolbar">
    <div class="seller-toolbar-inner">
        <div class="search-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="seller-search" placeholder="Search your products…" value="@currentSearch">
        </div>
        <span class="seller-count">
            <b id="sellerVisibleCount">@Model.TotalCount</b> products listed
        </span>
    </div>
</div>

<!-- ── GRID ── -->
<div class="seller-shop-wrap">
    <div class="seller-grid" id="seller-grid">

        @foreach (var product in Model.Items)
        {
            <div class="seller-card"
                 data-name="@product.ProductName.ToLower()"
                 data-description="@product.ProductDescription.ToLower()">

                <div class="seller-img-wrap">
                    <img src="/images/@(product.ProductImages?.FirstOrDefault() ?? "placeholder.jpg")"
                         alt="@product.ProductName"
                         loading="lazy">
                </div>

                <div class="seller-body">
                    <div class="seller-name">@product.ProductName</div>
                    <p class="seller-desc">@product.ProductDescription</p>
                    <div class="seller-price">@product.ProductPrice <span>EGP</span></div>
                </div>

                <div class="seller-footer">
                    <!-- ManageProductDetails is [HttpGet] after our refactor -->
                    <a asp-action="ManageProductDetails"
                       asp-controller="Product"
                       asp-route-id="@product.ProductId"
                       class="btn-manage">
                        <i class="fa-solid fa-pen-to-square"></i> Manage
                    </a>
                </div>

            </div>
        }

        <!-- Empty state — shown when no products exist or search filters everything out -->
        <div class="seller-empty" id="sellerEmpty">
            <i class="fa-solid fa-store"></i>
            <h3>No Products Yet</h3>
            <p>Your store is empty. Start by adding your first product.</p>
            <a asp-action="AddProduct" asp-controller="Product">
                <i class="fa-solid fa-plus"></i> Add Product
            </a>
        </div>

    </div>

    <!-- ── PAGINATION ── -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-bar">
            <div class="pagination-info">
                Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount))
                of @Model.TotalCount products
            </div>

            <div class="pagination-controls">

                @if (Model.HasPreviousPage)
                {
                    <a class="page-btn"
                       asp-action="ProductsForSeller" asp-controller="Product"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-search="@currentSearch">‹</a>
                }
                else
                {
                    <span class="page-btn disabled">‹</span>
                }

                @if (Model.PageWindow().First() > 1)
                {
                    <a class="page-btn"
                       asp-action="ProductsForSeller" asp-controller="Product"
                       asp-route-page="1"
                       asp-route-search="@currentSearch">1</a>
                    @if (Model.PageWindow().First() > 2)
                    {
                        <span class="page-ellipsis">…</span>
                    }
                }

                @foreach (var p in Model.PageWindow())
                {
                    <a class="page-btn @(p == Model.CurrentPage ? "active" : "")"
                       asp-action="ProductsForSeller" asp-controller="Product"
                       asp-route-page="@p"
                       asp-route-search="@currentSearch">@p</a>
                }

                @if (Model.PageWindow().Last() < Model.TotalPages)
                {
                    @if (Model.PageWindow().Last() < Model.TotalPages - 1)
                    {
                        <span class="page-ellipsis">…</span>
                    }
                    <a class="page-btn"
                       asp-action="ProductsForSeller" asp-controller="Product"
                       asp-route-page="@Model.TotalPages"
                       asp-route-search="@currentSearch">@Model.TotalPages</a>
                }

                @if (Model.HasNextPage)
                {
                    <a class="page-btn"
                       asp-action="ProductsForSeller" asp-controller="Product"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-search="@currentSearch">›</a>
                }
                else
                {
                    <span class="page-btn disabled">›</span>
                }

            </div>
        </div>
    }

</div>

<script>
    (function () {
        const searchInput = document.getElementById('seller-search');
        const grid        = document.getElementById('seller-grid');
        const countEl     = document.getElementById('sellerVisibleCount');
        const emptyState  = document.getElementById('sellerEmpty');

        // Filters visible cards on the current page instantly as you type
        function run() {
            const q = searchInput.value.toLowerCase().trim();
            const cards = Array.from(grid.querySelectorAll('.seller-card'));
            let visible = 0;

            cards.forEach(card => {
                const match = !q ||
                    card.dataset.name.includes(q) ||
                    card.dataset.description.includes(q);
                card.style.display = match ? '' : 'none';
                if (match) visible++;
            });

            countEl.textContent = visible;
            emptyState.style.display = visible === 0 ? 'flex' : 'none';
        }

        // Live filter on the current page's cards
        searchInput.addEventListener('input', run);

        // Enter → server-side search across all pages
        searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                window.location.href =
                    '/Product/ProductsForSeller?search=' +
                    encodeURIComponent(searchInput.value.trim());
            }
        });

        run();
    })();
</script>
