@model IEnumerable<EcomGalaxy.ViewModel.Product.ProductViewModel>
@{
    ViewBag.Title = "Shop";
    Layout = "~/Views/Shared/_MyLayout.cshtml";
}

<style>
    .page-header {
        padding: 48px 28px 24px;
        max-width: 1300px;
        margin: 0 auto;
    }

        .page-header .eyebrow {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #f97316;
            display: block;
            margin-bottom: 8px;
        }

        .page-header h1 {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(36px, 5vw, 64px);
            letter-spacing: 2px;
            color: #f0f0f0;
            margin: 0 0 6px;
            line-height: 1;
        }

        .page-header p {
            font-size: 14px;
            color: #777;
            margin: 0;
        }

    @@media (max-width: 768px) {
        .page-header {
            padding: 32px 16px 16px;
        }
    }
</style>

<div class="page-header">
    <span class="eyebrow">Browse the collection</span>
    <h1>All Products</h1>
    <p>Discover our full range — search, filter, and shop at your own pace.</p>
</div>

@await Html.PartialAsync("_ProductGrid", Model)
