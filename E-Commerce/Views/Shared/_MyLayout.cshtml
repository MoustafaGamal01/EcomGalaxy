@using EcomGalaxy.ApplicationLayer.Services.IServices
@inject UserManager<ApplicationUser> UserManager
@inject IShoppingCartService _shoppingCartService
@{
    ApplicationUser currentUser = null;
    int cartItemCount = 0;

    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null && User.IsInRole("Customer"))
        {
            var cart = await _shoppingCartService.GetOrCreateShoppingCartAsync(UserManager.GetUserId(User));
            cartItemCount = cart?.ShoppingCartItems?.Count ?? 0;
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewBag.Title ?? ViewData["Title"]) - EcomGalaxy</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        /* ── RESET & TOKENS ── */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #0f0f0f;
            --surface: #1a1a1a;
            --surface2: #222;
            --border: #2a2a2a;
            --accent: #f97316;
            --accent-lo: rgba(249,115,22,.12);
            --text: #f0f0f0;
            --muted: #777;
            --nav-h: 64px;
            --font-head: 'Bebas Neue', sans-serif;
            --font-body: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
            --radius: 10px;
            --ease: cubic-bezier(.4,0,.2,1);
            --trans: .22s var(--ease);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: var(--font-body);
            font-size: 15px;
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img {
            display: block;
            max-width: 100%;
        }

        /* ════════════════════════════════════════
                   NAVBAR
                ════════════════════════════════════════ */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--nav-h);
            z-index: 1000;
            display: flex;
            align-items: center;
            padding: 0 28px;
            gap: 12px;
            background: rgba(10,10,10,.88);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border-bottom: 1px solid rgba(255,255,255,.06);
            transition: box-shadow var(--trans);
        }

            .navbar.scrolled {
                box-shadow: 0 4px 32px rgba(0,0,0,.5);
            }

        /* Logo */
        .nav-logo {
            font-family: var(--font-head);
            font-size: 24px;
            letter-spacing: 3px;
            color: var(--text);
            white-space: nowrap;
            flex-shrink: 0;
            transition: opacity var(--trans);
        }

            .nav-logo:hover {
                opacity: .8;
            }

            .nav-logo em {
                color: var(--accent);
                font-style: normal;
            }

        /* Divider */
        .nav-divider {
            width: 1px;
            height: 20px;
            background: var(--border);
            flex-shrink: 0;
            margin: 0 4px;
        }

        /* Desktop links */
        .nav-links {
            list-style: none;
            display: flex;
            align-items: center;
            gap: 2px;
            flex: 1;
        }

            .nav-links a {
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 6px 12px;
                border-radius: 7px;
                font-size: 13px;
                font-weight: 500;
                color: var(--muted);
                letter-spacing: .2px;
                transition: color var(--trans), background var(--trans);
                white-space: nowrap;
            }

                .nav-links a i {
                    font-size: 11px;
                }

                .nav-links a:hover,
                .nav-links a.active {
                    color: var(--text);
                    background: rgba(255,255,255,.07);
                }

        /* Right actions */
        .nav-actions {
            display: flex;
            align-items: center;
            gap: 4px;
            flex-shrink: 0;
            margin-left: auto;
        }

            .nav-actions a {
                display: flex;
                align-items: center;
                gap: 7px;
                padding: 7px 14px;
                border-radius: var(--radius);
                font-size: 13px;
                font-weight: 500;
                color: var(--muted);
                white-space: nowrap;
                transition: color var(--trans), background var(--trans);
            }

                .nav-actions a:hover {
                    color: var(--text);
                    background: rgba(255,255,255,.07);
                }

        .nav-btn-primary {
            background: var(--accent) !important;
            color: #fff !important;
            font-weight: 600 !important;
        }

            .nav-btn-primary:hover {
                background: #e8660a !important;
            }

        /* Cart */
        .nav-cart {
            position: relative;
        }

        .nav-cart-badge {
            position: absolute;
            top: 3px;
            right: 3px;
            background: var(--accent);
            color: #fff;
            border-radius: 99px;
            min-width: 16px;
            height: 16px;
            font-size: 9px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            pointer-events: none;
            border: 1.5px solid var(--bg);
        }

        /* User greeting chip */
        .nav-user-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 5px 12px 5px 5px;
            border-radius: 99px;
            border: 1px solid var(--border);
            font-size: 13px;
            color: var(--text);
            transition: border-color var(--trans), background var(--trans);
        }

            .nav-user-chip:hover {
                border-color: var(--accent);
                background: rgba(249,115,22,.05);
            }

        .nav-user-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--accent);
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        /* Logout link */
        .nav-logout {
            color: var(--muted) !important;
            font-size: 13px;
        }

            .nav-logout:hover {
                color: #ff6b6b !important;
                background: rgba(255,107,107,.07) !important;
            }

        /* ── HAMBURGER ── */
        .hamburger {
            display: none;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            width: 38px;
            height: 38px;
            background: rgba(255,255,255,.05);
            border: 1px solid var(--border);
            border-radius: 8px;
            cursor: pointer;
            padding: 8px;
            flex-shrink: 0;
            transition: background var(--trans);
        }

            .hamburger:hover {
                background: rgba(255,255,255,.1);
            }

            .hamburger span {
                display: block;
                height: 1.5px;
                background: var(--text);
                border-radius: 2px;
                transition: transform var(--trans), opacity var(--trans), width var(--trans);
                width: 100%;
                transform-origin: center;
            }

            .hamburger.open span:nth-child(1) {
                transform: translateY(6.5px) rotate(45deg);
            }

            .hamburger.open span:nth-child(2) {
                opacity: 0;
                transform: scaleX(0);
            }

            .hamburger.open span:nth-child(3) {
                transform: translateY(-6.5px) rotate(-45deg);
            }

        /* ════════════════════════════════════════
                   MOBILE DRAWER
                ════════════════════════════════════════ */
        .mobile-drawer {
            position: fixed;
            top: var(--nav-h);
            left: 0;
            right: 0;
            z-index: 999;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 12px 16px 20px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            transform: translateY(-8px);
            opacity: 0;
            pointer-events: none;
            transition: transform .25s var(--ease), opacity .25s var(--ease);
        }

            .mobile-drawer.open {
                transform: translateY(0);
                opacity: 1;
                pointer-events: all;
            }

        .drawer-section-label {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--muted);
            padding: 10px 12px 4px;
        }

        .mobile-drawer a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: var(--radius);
            font-size: 14px;
            font-weight: 500;
            color: var(--text);
            transition: background var(--trans), color var(--trans);
        }

            .mobile-drawer a:hover {
                background: rgba(255,255,255,.07);
            }

            .mobile-drawer a i {
                width: 18px;
                text-align: center;
                font-size: 13px;
                color: var(--accent);
                flex-shrink: 0;
            }

        .drawer-divider {
            height: 1px;
            background: var(--border);
            margin: 6px 0;
        }

        .drawer-user-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            background: rgba(249,115,22,.06);
            border: 1px solid rgba(249,115,22,.15);
            border-radius: var(--radius);
            margin-bottom: 4px;
        }

        .drawer-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--accent);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .drawer-user-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
        }

        .drawer-user-role {
            font-size: 11px;
            color: var(--muted);
        }

        .drawer-logout {
            color: #ff7070 !important;
        }

            .drawer-logout i {
                color: #ff7070 !important;
            }

            .drawer-logout:hover {
                background: rgba(255,107,107,.08) !important;
            }

        /* ════════════════════════════════════════
                   MAIN
                ════════════════════════════════════════ */
        .site-main {
            flex: 1;
            margin-top: var(--nav-h);
        }

        /* ════════════════════════════════════════
                   FOOTER
                ════════════════════════════════════════ */
        .site-footer {
            background: var(--surface);
            border-top: 1px solid var(--border);
            padding: 56px 28px 0;
        }

        .footer-inner {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Top row: brand + columns */
        .footer-top {
            display: grid;
            grid-template-columns: 1.4fr repeat(3, 1fr);
            gap: 48px;
            padding-bottom: 48px;
        }

        .footer-brand .footer-logo {
            font-family: var(--font-head);
            font-size: 28px;
            letter-spacing: 3px;
            color: var(--text);
            display: block;
            margin-bottom: 14px;
        }

            .footer-brand .footer-logo em {
                color: var(--accent);
                font-style: normal;
            }

        .footer-brand p {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.75;
            max-width: 240px;
        }

        .footer-col h5 {
            font-family: var(--font-head);
            font-size: 16px;
            letter-spacing: 2px;
            color: var(--text);
            margin-bottom: 18px;
        }

        .footer-col ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 11px;
        }

            .footer-col ul li a {
                font-size: 13px;
                color: var(--muted);
                transition: color var(--trans), padding-left var(--trans);
                display: flex;
                align-items: center;
                gap: 7px;
            }

                .footer-col ul li a:hover {
                    color: var(--accent);
                    padding-left: 4px;
                }

                .footer-col ul li a i {
                    font-size: 10px;
                    opacity: .5;
                }

        /* Social */
        .footer-social {
            display: flex;
            gap: 10px;
            margin-top: 4px;
        }

            .footer-social a {
                width: 38px;
                height: 38px;
                border-radius: 9px;
                background: var(--surface2);
                border: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
                color: var(--muted);
                transition: background var(--trans), color var(--trans), border-color var(--trans), transform var(--trans);
            }

                .footer-social a:hover {
                    background: var(--accent);
                    color: #fff;
                    border-color: var(--accent);
                    transform: translateY(-3px);
                }

        /* Contact items */
        .footer-contact-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 12px;
        }

            .footer-contact-item i {
                color: var(--accent);
                width: 14px;
                text-align: center;
                margin-top: 3px;
                flex-shrink: 0;
            }

            .footer-contact-item a {
                color: var(--muted);
                transition: color var(--trans);
            }

                .footer-contact-item a:hover {
                    color: var(--accent);
                }

        /* Bottom bar */
        .footer-bottom {
            border-top: 1px solid var(--border);
            padding: 20px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            font-size: 12px;
            color: var(--muted);
        }

            .footer-bottom b {
                color: var(--accent);
                font-weight: 600;
            }

        .footer-bottom-links {
            display: flex;
            gap: 20px;
        }

            .footer-bottom-links a {
                color: var(--muted);
                font-size: 12px;
                transition: color var(--trans);
            }

                .footer-bottom-links a:hover {
                    color: var(--text);
                }

        @@media (max-width: 1024px) {
            .footer-top {
                grid-template-columns: 1fr 1fr;
                gap: 36px;
            }
        }

        @@media (max-width: 768px) {
            .navbar {
                padding: 0 16px;
            }

            .nav-links,
            .nav-actions,
            .nav-divider {
                display: none;
            }

            .hamburger {
                display: flex;
            }

            .nav-logo {
                font-size: 21px;
            }

            .footer-top {
                grid-template-columns: 1fr 1fr;
                gap: 28px;
            }

            .footer-brand {
                grid-column: 1 / -1;
            }

            .site-footer {
                padding: 40px 20px 0;
            }
        }

        @@media (max-width: 480px) {
            .footer-top {
                grid-template-columns: 1fr;
            }

            .footer-bottom {
                flex-direction: column;
                text-align: center;
            }

            .footer-bottom-links {
                justify-content: center;
            }
        }

        @@media (min-width: 769px) {
            .mobile-drawer {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <nav class="navbar" id="navbar">
        <a href="/Home/Index" class="nav-logo">Ecom<em>Galaxy</em></a>
        <div class="nav-divider"></div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <ul class="nav-links">
                @if (User.IsInRole("Admin"))
                {
                    <li><a href="/Home/Index"><i class="fa-solid fa-house"></i> Home</a></li>
                    <li><a href="/Role/AddRole"><i class="fa-solid fa-shield-halved"></i> Roles</a></li>
                    <li><a href="/User/ManageUsers"><i class="fa-solid fa-users"></i> Users</a></li>
                    <li><a href="/Category/ManageCategories"><i class="fa-solid fa-tags"></i> Categories</a></li>
                    <li><a href="/Order/AdminOrders"><i class="fa-solid fa-box-open"></i> Orders</a></li>
                }
                else if (User.IsInRole("Seller"))
                {
                    <li><a href="/Product/ProductsForSeller"><i class="fa-solid fa-store"></i> My Store</a></li>
                    <li><a href="/Order/SellerOrders"><i class="fa-solid fa-box-open"></i> Orders</a></li>
                }
                else
                {
                    <li><a href="/Home/Index"><i class="fa-solid fa-house"></i> Home</a></li>
                    <li><a href="/Product/Index"><i class="fa-solid fa-store"></i> Shop</a></li>
                    <li><a href="/Order/CustomerOrders"><i class="fa-solid fa-box-open"></i> My Orders</a></li>
                    <li><a href="#contact-info"><i class="fa-solid fa-envelope"></i> Contact</a></li>
                }
            </ul>
        }
        else
        {
            <ul class="nav-links">
                <li><a href="/Home/Index"><i class="fa-solid fa-house"></i> Home</a></li>
                <li><a href="#contact-info"><i class="fa-solid fa-envelope"></i> Contact</a></li>
            </ul>
        }

        <div class="nav-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (currentUser != null)
                {
                    <a href="/User/Profile" class="nav-user-chip">
                        <span class="nav-user-avatar">@currentUser.Name[0].ToString().ToUpper()</span>
                        @currentUser.Name
                    </a>
                }
                <a href="/Auth/Logout" class="nav-logout" title="Logout">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            }
            else
            {
                <a href="/Auth/LoginForm">Log in</a>
                <a href="/Auth/RegisterForm" class="nav-btn-primary">Register</a>
            }

            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
            {
                <a href="/ShoppingCart/ViewCart" class="nav-cart" title="Shopping cart">
                    <i class="fa-solid fa-bag-shopping" style="font-size:16px; color:var(--text)"></i>
                    @if (cartItemCount > 0)
                    {
                        <span class="nav-cart-badge">@cartItemCount</span>
                    }
                </a>
            }
        </div>

        <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
    </nav>

    <!-- ════════════════════════════════════════
         MOBILE DRAWER
    ════════════════════════════════════════ -->
    <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">

        @if (User.Identity?.IsAuthenticated == true && currentUser != null)
        {
            <div class="drawer-user-row">
                <div class="drawer-avatar">@currentUser.Name[0].ToString().ToUpper()</div>
                <div>
                    <div class="drawer-user-name">@currentUser.Name</div>
                    <div class="drawer-user-role">
                        @if (User.IsInRole("Admin"))
                        {
                            <text>Administrator</text>
                        }
                        else if (User.IsInRole("Seller"))
                        {

                            <text>Seller</text>
                        }
                        else
                        {

                            <text>Customer</text>
                        }
                    </div>
                </div>
            </div>
        }

        <span class="drawer-section-label">Navigation</span>

        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (User.IsInRole("Admin"))
            {
                <a href="/Home/Index"><i class="fa-solid fa-house"></i> Home</a>
                <a href="/Role/AddRole"><i class="fa-solid fa-shield-halved"></i> Add Role</a>
                <a href="/User/ManageUsers"><i class="fa-solid fa-users"></i> Manage Users</a>
                <a href="/Category/ManageCategories"><i class="fa-solid fa-tags"></i> Manage Categories</a>
                <a href="/Order/AdminOrders"><i class="fa-solid fa-box-open"></i> Manage Orders</a>
            }
            else if (User.IsInRole("Seller"))
            {
                <a href="/Product/ProductsForSeller"><i class="fa-solid fa-store"></i> My Store</a>
                <a href="/Order/SellerOrders"><i class="fa-solid fa-box-open"></i> My Orders</a>
            }
            else
            {
                <a href="/Home/Index"><i class="fa-solid fa-house"></i> Home</a>
                <a href="/Product/Index"><i class="fa-solid fa-store"></i> Shop</a>
                <a href="/Order/CustomerOrders"><i class="fa-solid fa-box-open"></i> My Orders</a>
                @if (cartItemCount > 0)
                {
                    <a href="/ShoppingCart/ViewCart">
                        <i class="fa-solid fa-bag-shopping"></i>
                        Cart
                        <span style="margin-left:auto; background:var(--accent); color:#fff; border-radius:99px; padding:1px 8px; font-size:11px; font-weight:700;">@cartItemCount</span>
                    </a>
                }
                else
                {
                    <a href="/ShoppingCart/ViewCart"><i class="fa-solid fa-bag-shopping"></i> Cart</a>
                }
                <a href="#contact-info"><i class="fa-solid fa-envelope"></i> Contact</a>
            }
        }
        else
        {
            <a href="/Home/Index"><i class="fa-solid fa-house"></i> Home</a>
            <a href="#contact-info"><i class="fa-solid fa-envelope"></i> Contact</a>
        }

        <div class="drawer-divider"></div>
        <span class="drawer-section-label">Account</span>

        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (currentUser != null)
            {
                <a href="/User/Profile"><i class="fa-solid fa-circle-user"></i> My Profile</a>
            }
            <a href="/Auth/Logout" class="drawer-logout"><i class="fa-solid fa-right-from-bracket"></i> Log Out</a>
        }
        else
        {
            <a href="/Auth/LoginForm"><i class="fa-solid fa-right-to-bracket"></i> Log In</a>
            <a href="/Auth/RegisterForm" style="color: var(--accent)"><i class="fa-solid fa-user-plus"></i> Create Account</a>
        }
    </div>

    <!-- ════════════════════════════════════════
         MAIN CONTENT
    ════════════════════════════════════════ -->
    <main class="site-main">
        @RenderBody()
    </main>

    <!-- ════════════════════════════════════════
         FOOTER
    ════════════════════════════════════════ -->
    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-top">

                <!-- Brand -->
                <div class="footer-brand">
                    <a href="/Home/Index" class="footer-logo">Ecom<em>Galaxy</em></a>
                    <p>Your one-stop destination for the latest trends. Shop smart, discover more, live bold.</p>
                </div>

                <!-- Policies -->
                <div class="footer-col">
                    <h5>Company</h5>
                    <ul>
                        <li><a href="#"><i class="fa-solid fa-chevron-right"></i> Privacy Policy</a></li>
                        <li><a href="#"><i class="fa-solid fa-chevron-right"></i> Terms of Service</a></li>
                        <li><a href="#"><i class="fa-solid fa-chevron-right"></i> Cookie Policy</a></li>
                        <li><a href="#"><i class="fa-solid fa-chevron-right"></i> Refund Policy</a></li>
                    </ul>
                </div>

                <!-- Social -->
                <div class="footer-col">
