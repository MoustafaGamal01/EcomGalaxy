@model IEnumerable<EcomGalaxy.ViewModel.Product.ProductViewModel>
@{
    ViewBag.Title = ViewBag.CategoryName ?? "Category";
    Layout = "~/Views/Shared/_MyLayout.cshtml";
}

<style>
    .page-header {
        padding: 48px 28px 24px;
        max-width: 1300px;
        margin: 0 auto;
    }

        .page-header .eyebrow {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #f97316;
            display: block;
            margin-bottom: 8px;
        }

        .page-header h1 {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(36px, 5vw, 64px);
            letter-spacing: 2px;
            color: #f0f0f0;
            margin: 0 0 6px;
            line-height: 1;
        }

        .page-header p {
            font-size: 14px;
            color: #777;
            margin: 0;
        }

        .page-header .back-link {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 13px;
            color: #777;
            text-decoration: none;
            margin-bottom: 20px;
            transition: color .22s;
        }

            .page-header .back-link:hover {
                color: #f97316;
            }

            .page-header .back-link i {
                font-size: 11px;
            }

    @@media (max-width: 768px) {
        .page-header {
            padding: 32px 16px 16px;
        }
    }
</style>

<div class="page-header">
    <a href="/Home/Index" class="back-link">
        <i class="fa-solid fa-arrow-left"></i> Back to Home
    </a>
    <span class="eyebrow">Browsing category</span>
    <h1>@(ViewBag.CategoryName ?? "Products")</h1>
    <p>Showing all products in the @(ViewBag.CategoryName ?? "selected") category.</p>
</div>

@await Html.PartialAsync("_ProductGrid", Model)
