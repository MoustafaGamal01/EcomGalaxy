@model CustomerRegisterViewModel
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_MyLayout.cshtml";
}

<style>
    :root {
        --bg: #0f0f0f;
        --surface: #1a1a1a;
        --surface2: #222;
        --border: #2a2a2a;
        --accent: #f97316;
        --text: #f0f0f0;
        --muted: #777;
        --danger: #f87171;
        --font-head: 'Bebas Neue', sans-serif;
        --font-body: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
        --radius: 12px;
        --trans: .22s cubic-bezier(.4,0,.2,1);
    }

    /* ── AUTH SHELL ── */
    .auth-page {
        min-height: calc(100vh - 64px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 48px 20px 80px;
        position: relative;
        overflow: hidden;
    }

        .auth-page::before,
        .auth-page::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(80px);
            opacity: .3;
        }

        .auth-page::before {
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(249,115,22,.5), transparent 70%);
            top: -100px;
            right: -100px;
        }

        .auth-page::after {
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(249,115,22,.3), transparent 70%);
            bottom: -80px;
            left: -80px;
        }

    /* ── CARD ── */
    .auth-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 560px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 44px 44px 40px;
        box-shadow: 0 24px 80px rgba(0,0,0,.5);
    }

    /* Header */
    .auth-header {
        text-align: center;
        margin-bottom: 36px;
    }

    .auth-logo {
        font-family: var(--font-head);
        font-size: 22px;
        letter-spacing: 3px;
        color: var(--muted);
        display: block;
        margin-bottom: 20px;
        text-decoration: none;
        transition: color var(--trans);
    }

        .auth-logo em {
            color: var(--accent);
            font-style: normal;
        }

        .auth-logo:hover {
            color: var(--text);
        }

    .auth-header h1 {
        font-family: var(--font-head);
        font-size: 42px;
        letter-spacing: 3px;
        color: var(--text);
        margin: 0 0 8px;
    }

    .auth-header p {
        font-size: 13px;
        color: var(--muted);
        margin: 0;
    }

    /* Validation summary */
    .auth-error {
        background: rgba(248,113,113,.1);
        border: 1px solid rgba(248,113,113,.3);
        border-radius: var(--radius);
        padding: 12px 16px;
        margin-bottom: 24px;
        font-size: 13px;
        color: var(--danger);
    }

        .auth-error ul {
            margin: 0;
            padding-left: 16px;
        }

    /* ── SECTION LABEL ── */
    .form-section {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--muted);
        padding: 4px 0 14px;
        margin-top: 8px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .form-section i {
            color: var(--accent);
            font-size: 11px;
        }

    /* ── FIELD GRID ── */
    .fields-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .field-full {
        grid-column: 1 / -1;
    }

    /* ── FIELD ── */
    .field {
        margin-bottom: 16px;
    }

    .field-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 7px;
    }

    .field-wrap {
        position: relative;
        display: flex;
        align-items: center;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        transition: border-color var(--trans), box-shadow var(--trans);
    }

        .field-wrap:focus-within {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(249,115,22,.12);
        }

        .field-wrap i {
            padding: 0 13px;
            color: var(--muted);
            font-size: 12px;
            flex-shrink: 0;
            pointer-events: none;
        }

        .field-wrap input {
            flex: 1;
            background: none;
            border: none;
            outline: none;
            color: var(--text);
            font-family: var(--font-body);
            font-size: 14px;
            padding: 12px 13px 12px 0;
        }

            .field-wrap input::placeholder {
                color: var(--muted);
            }

    /* Password toggle */
    .pwd-toggle {
        padding: 0 13px;
        color: var(--muted);
        font-size: 12px;
        cursor: pointer;
        flex-shrink: 0;
        background: none;
        border: none;
        outline: none;
        transition: color var(--trans);
    }

        .pwd-toggle:hover {
            color: var(--text);
        }

    .field-error {
        font-size: 12px;
        color: var(--danger);
        margin-top: 5px;
        display: block;
    }

    /* Submit */
    .btn-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 14px;
        background: var(--accent);
        color: #fff;
        font-family: var(--font-body);
        font-size: 15px;
        font-weight: 600;
        border: none;
        border-radius: var(--radius);
        cursor: pointer;
        margin-top: 28px;
        transition: background var(--trans), transform var(--trans), box-shadow var(--trans);
        letter-spacing: .3px;
    }

        .btn-submit:hover {
            background: #e8660a;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(249,115,22,.35);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

    /* Divider */
    .auth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 24px 0;
        color: var(--muted);
        font-size: 12px;
    }

        .auth-divider::before,
        .auth-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

    /* Switch */
    .auth-switch {
        text-align: center;
        font-size: 13px;
        color: var(--muted);
    }

        .auth-switch a {
            color: var(--accent);
            font-weight: 600;
            text-decoration: none;
            transition: opacity var(--trans);
        }

            .auth-switch a:hover {
                opacity: .8;
            }

    /* ── RESPONSIVE ── */
    @@media (max-width: 560px) {
        .auth-card {
            padding: 28px 20px 24px;
        }

        .fields-row {
            grid-template-columns: 1fr;
        }

        .field-full {
            grid-column: auto;
        }

        .auth-header h1 {
            font-size: 34px;
        }
    }
</style>

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <a href="/Home/Index" class="auth-logo">Ecom<em>Galaxy</em></a>
            <h1>Create Account</h1>
            <p>Join EcomGalaxy and start shopping today.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-error">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Register" asp-controller="Auth" method="post">

            <!-- Account Info -->
            <div class="form-section">
                <i class="fa-solid fa-circle-user"></i> Account Info
            </div>

            <div class="fields-row">
                <div class="field">
                    <label class="field-label" asp-for="Name">Full Name</label>
                    <div class="field-wrap">
                        <i class="fa-solid fa-user"></i>
                        <input asp-for="Name" type="text" placeholder="John Doe" autocomplete="name" />
                    </div>
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="UserName">Username</label>
                    <div class="field-wrap">
                        <i class="fa-solid fa-at"></i>
                        <input asp-for="UserName" type="text" placeholder="johndoe" autocomplete="username" />
                    </div>
                    <span asp-validation-for="UserName" class="field-error"></span>
                </div>

                <div class="field field-full">
                    <label class="field-label" asp-for="Email">Email Address</label>
                    <div class="field-wrap">
                        <i class="fa-solid fa-envelope"></i>
                        <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="Password">Password</label>
                    <div class="field-wrap">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Password" type="password" id="pwdInput" placeholder="••••••••" autocomplete="new-password" />
                        <button type="button" class="pwd-toggle" id="pwdToggle1" aria-label="Toggle password">
                            <i class="fa-solid fa-eye" id="pwdIcon1"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="ConfirmPassword">Confirm Password</label>
                    <div class="field-wrap">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="ConfirmPassword" type="password" id="confirmPwdInput" placeholder="••••••••" autocomplete="new-password" />
                        <button type="button" class="pwd-toggle" id="pwdToggle2" aria-label="Toggle password">
                            <i class="fa-solid fa-eye" id="pwdIcon2"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
            </div>

            <!-- Shipping Address -->
            <div class="form-section" style="margin-top:24px">
                <i class="fa-solid fa-location-dot"></i> Shipping Address
            </div>

            <div class="fields-row">
                <div class="field">
                    <label class="field-label" asp-for="Country">Country</label>
                    <div class="field-wrap">
                        <i class="fa-solid fa-earth-africa"></i>
                        <input asp-for="Country" type="text" placeholder="Egypt" autocomplete="country-name" />
                    </div>
                    <span asp-validation-for="Country" class="field-error"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="City">City</label>
                    <div class="field-wrap">
                        <i class="fa-solid fa-city"></i>
                        <input asp-for="City" type="text" placeholder="Cairo" autocomplete="address-level2" />
                    </div>
                    <span asp-validation-for="City" class="field-error"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="Street">Street</label>
                    <div class="field-wrap">
                        <i class="fa-solid fa-road"></i>
                        <input asp-for="Street" type="text" placeholder="123 Main St" autocomplete="street-address" />
                    </div>
                    <span asp-validation-for="Street" class="field-error"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="PostalCode">Postal Code</label>
                    <div class="field-wrap">
                        <i class="fa-solid fa-map-pin"></i>
                        <input asp-for="PostalCode" type="text" placeholder="11511" autocomplete="postal-code" />
                    </div>
                    <span asp-validation-for="PostalCode" class="field-error"></span>
                </div>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fa-solid fa-user-plus"></i>
                Create Account
            </button>

        </form>

        <div class="auth-divider">or</div>

        <div class="auth-switch">
            Already have an account? <a href="/Auth/LoginForm">Sign in</a>
        </div>

    </div>
</div>

<script>
    function togglePwd(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon  = document.getElementById(iconId);
        const isHidden = input.type === 'password';
        input.type  = isHidden ? 'text' : 'password';
        icon.className = isHidden ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
    }

    document.getElementById('pwdToggle1').addEventListener('click', () => togglePwd('pwdInput', 'pwdIcon1'));
    document.getElementById('pwdToggle2').addEventListener('click', () => togglePwd('confirmPwdInput', 'pwdIcon2'));
</script>

@section Scripts {
    @{
        await Html.PartialAsync("_ValidationScriptsPartial");
    }
}
