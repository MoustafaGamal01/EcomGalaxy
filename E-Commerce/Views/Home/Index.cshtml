@model IEnumerable<Category>
@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_MyLayout.cshtml";
}

<style>
    :root {
        --bg: #0f0f0f;
        --surface: #1a1a1a;
        --border: #2a2a2a;
        --accent: #f97316;
        --text: #f0f0f0;
        --muted: #888;
        --font-head: 'Bebas Neue', sans-serif;
        --font-body: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
        --radius: 14px;
        --trans: .28s cubic-bezier(.4,0,.2,1);
    }

    /* ── HERO ── */
    .hero {
        position: relative;
        width: 100%;
        height: min(580px, 56vw);
        overflow: hidden;
    }

        .hero img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            filter: brightness(.55);
            transform: scale(1.04);
            animation: heroZoom 8s ease forwards;
        }

    @@keyframes heroZoom {
        to {
            transform: scale(1);
        }
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0 20px;
        gap: 18px;
        animation: fadeUp .9s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(28px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-label {
        display: inline-block;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--accent);
        background: rgba(249,115,22,.12);
        border: 1px solid rgba(249,115,22,.35);
        padding: 5px 16px;
        border-radius: 99px;
    }

    .hero h1 {
        font-family: var(--font-head);
        font-size: clamp(38px, 6vw, 90px);
        letter-spacing: 3px;
        color: #fff;
        line-height: 1.05;
        margin: 0;
    }

        .hero h1 span {
            color: var(--accent);
        }

    .hero p {
        font-size: clamp(14px, 1.4vw, 18px);
        color: rgba(255,255,255,.72);
        max-width: 500px;
        margin: 0;
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 30px;
        background: var(--accent);
        color: #fff;
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 600;
        border-radius: var(--radius);
        text-decoration: none;
        transition: background var(--trans), transform var(--trans);
    }

        .btn-primary:hover {
            background: #ea6d09;
            transform: translateY(-2px);
        }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 30px;
        border: 1.5px solid rgba(255,255,255,.3);
        color: #fff;
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 500;
        border-radius: var(--radius);
        text-decoration: none;
        backdrop-filter: blur(6px);
        transition: border-color var(--trans), background var(--trans), transform var(--trans);
    }

        .btn-ghost:hover {
            border-color: #fff;
            background: rgba(255,255,255,.08);
            transform: translateY(-2px);
        }

    /* ── SECTION HEADER ── */
    .section-header {
        text-align: center;
        padding: 72px 20px 40px;
        animation: fadeUp .6s ease both;
    }

        .section-header .eyebrow {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--accent);
            display: block;
            margin-bottom: 10px;
        }

        .section-header h2 {
            font-family: var(--font-head);
            font-size: clamp(32px, 4vw, 52px);
            letter-spacing: 2px;
            color: var(--text);
            margin: 0 0 12px;
        }

        .section-header p {
            font-size: 14px;
            color: var(--muted);
            max-width: 420px;
            margin: 0 auto;
        }

    /* ── CATEGORY GRID ── */
    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        padding: 0 24px 16px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .cat-card {
        position: relative;
        border-radius: var(--radius);
        overflow: hidden;
        height: 360px;
        display: block;
        text-decoration: none;
        background: var(--surface);
        border: 1px solid var(--border);
        cursor: pointer;
        animation: fadeUp .5s ease both;
    }

        .cat-card:nth-child(1) {
            animation-delay: .05s
        }

        .cat-card:nth-child(2) {
            animation-delay: .10s
        }

        .cat-card:nth-child(3) {
            animation-delay: .15s
        }

        .cat-card:nth-child(4) {
            animation-delay: .20s
        }

        .cat-card:nth-child(5) {
            animation-delay: .25s
        }

        .cat-card:nth-child(6) {
            animation-delay: .30s
        }

        .cat-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .55s cubic-bezier(.4,0,.2,1), filter .55s ease;
            filter: brightness(.6);
        }

        .cat-card:hover img {
            transform: scale(1.07);
            filter: brightness(.4);
        }

    .cat-info {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 28px 22px 22px;
        background: linear-gradient(to top, rgba(0,0,0,.85) 0%, transparent 100%);
        transition: padding var(--trans);
    }

    .cat-card:hover .cat-info {
        padding-bottom: 28px;
    }

    .cat-info h3 {
        font-family: var(--font-head);
        font-size: 26px;
        letter-spacing: 2px;
        color: #fff;
        margin: 0 0 4px;
    }

    .cat-info p {
        font-size: 12px;
        color: rgba(255,255,255,.6);
        margin: 0 0 14px;
    }

    .cat-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        background: var(--accent);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        border-radius: 8px;
        opacity: 0;
        transform: translateY(8px);
        transition: opacity var(--trans), transform var(--trans);
    }

    .cat-card:hover .cat-btn {
        opacity: 1;
        transform: translateY(0);
    }

    /* ── VIEW ALL ── */
    .view-all {
        text-align: center;
        padding: 36px 20px 72px;
        color: gray;
    }

    .btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 36px;
        border: 1.5px solid var(--border);
        color: var(--text);
        font-size: 14px;
        font-weight: 500;
        border-radius: var(--radius);
        text-decoration: none;
        transition: border-color var(--trans), background var(--trans), transform var(--trans);
    }

        .btn-outline:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: rgba(249,115,22,.06);
            transform: translateY(-2px);
        }

    /* ── BANNER ── */
    .banner-wrap {
        padding: 0 24px 80px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .banner {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        min-height: min(380px, 44vw);
        border: 1px solid var(--border);
        background: radial-gradient(ellipse at 75% 50%, rgba(249,115,22,.22) 0%, transparent 60%), radial-gradient(ellipse at 15% 80%, rgba(249,115,22,.08) 0%, transparent 50%), linear-gradient(135deg, #1c1c1c 0%, #111 100%);
        display: flex;
        align-items: center;
    }
        /* Subtle grid lines */
        .banner::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(249,115,22,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(249,115,22,.05) 1px, transparent 1px);
            background-size: 48px 48px;
            pointer-events: none;
        }
        /* Glowing orb */
        .banner::after {
            content: '';
            position: absolute;
            right: 5%;
            top: 50%;
            transform: translateY(-50%);
            width: min(360px, 38vw);
            height: min(360px, 38vw);
            background: radial-gradient(circle, rgba(249,115,22,.28) 0%, transparent 68%);
            border-radius: 50%;
            pointer-events: none;
        }

    .banner-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        padding: clamp(32px, 5vw, 72px);
        gap: 16px;
    }

        .banner-content .eyebrow {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--accent);
            background: rgba(249,115,22,.12);
            border: 1px solid rgba(249,115,22,.3);
            padding: 5px 14px;
            border-radius: 99px;
            display: inline-block;
        }

        .banner-content h2 {
            font-family: var(--font-head);
            font-size: clamp(30px, 4.5vw, 64px);
            letter-spacing: 2px;
            color: #fff;
            margin: 0;
            line-height: 1.05;
            max-width: 520px;
        }

        .banner-content p {
            font-size: clamp(13px, 1.2vw, 16px);
            color: var(--muted);
            max-width: 400px;
            margin: 0;
        }

    /* ── RESPONSIVE ── */
    @@media (max-width: 600px) {
        .hero {
            height: 70vw;
            min-height: 320px;
        }

        .category-grid {
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            padding: 0 16px;
        }

        .cat-card {
            height: 220px;
        }

        .cat-info h3 {
            font-size: 18px;
        }

        .banner-wrap {
            padding: 0 16px 60px;
        }

        .banner {
            min-height: 200px;
        }

        .cat-btn {
            opacity: 1;
            transform: none;
        }
    }

    @@media (max-width: 380px) {
        .category-grid {
            grid-template-columns: 1fr;
        }

        .cat-card {
            height: 260px;
        }
    }
</style>

<!-- ── HERO ── -->
<section class="hero">
    <img src="~/images/background1.png" alt="Hero background">
    <div class="hero-overlay">
        <span class="hero-label">New Season Arrivals</span>
        <h1>Shop the <span>Latest</span><br>Trends</h1>
        <p>Find your favorite styles, discover new brands, and more — all in one place.</p>
        <div class="hero-actions">
            <a href="/Product/Index" class="btn-primary">
                <i class="fa-solid fa-bag-shopping"></i> Shop Now
            </a>
            <a href="#categories" class="btn-ghost">Browse Categories</a>
        </div>
    </div>
</section>

<!-- ── CATEGORIES ── -->
<section id="categories">
    <div class="section-header">
        <span class="eyebrow">What are you looking for?</span>
        <h2>Shop by Category</h2>
        <p>Browse our curated collections and find exactly what you need.</p>
    </div>

    <div class="category-grid">
        @foreach (var category in Model)
        {
            <a href="/Product/GetProductByCategory?categoryTitle=@category.Name" class="cat-card">
                <img src="/images/@category.CategoryImage" alt="@category.Name">
                <div class="cat-info">
                    <h3>@category.Name</h3>
                    <p>Shop Trendy @category.Name Now</p>
                    <span class="cat-btn">
                        Shop Now <i class="fa-solid fa-arrow-right"></i>
                    </span>
                </div>
            </a>
        }
    </div>

    <div class="view-all">
        <a href="/Product/Index" class="btn-outline">
            View All Products <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
</section>

<!-- ── BANNER ── -->
<div class="banner-wrap">
    <div class="banner">
        <div class="banner-content">
            <span class="eyebrow">Limited Time</span>
            <h2>Explore Our New Collection</h2>
            <p>Fresh drops every week. Be the first to discover what's new this season.</p>
            <a href="/Product/Index" class="btn-primary" style="margin-top:8px">
                Discover Now <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </div>
</div>
