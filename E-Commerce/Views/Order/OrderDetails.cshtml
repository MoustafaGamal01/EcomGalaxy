@model IEnumerable<CustomerOrderItemViewModel>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order #@ViewBag.OrderId</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: #1a1a1a;
            font-family: inherit;
            min-height: 100vh;
            padding: 40px 20px;
            color: #f0f0f0;
        }

        .page {
            width: 100%;
            max-width: 760px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* Header */
        .page-title {
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #555;
            font-weight: 500;
            margin-bottom: 4px;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .page-heading {
            font-size: 28px;
            font-weight: 500;
            color: #f0f0f0;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            padding: 9px 18px;
            border-radius: 8px;
            font-family: inherit;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.25s ease;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border: 1px solid #444;
            background: none;
            color: #888;
            text-decoration: none;
        }

            .back-btn:hover {
                border-color: #888;
                color: #ccc;
            }

        /* Card */
        .card {
            background: #242424;
            border: 1px solid #333;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
            overflow: hidden;
        }

        /* Order item row */
        .order-item {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 20px 24px;
            border-bottom: 1px solid #2e2e2e;
            transition: background 0.2s;
        }

            .order-item:last-child {
                border-bottom: none;
            }

            .order-item:hover {
                background: #2a2a2a;
            }

        .item-image img {
            width: 90px;
            height: 90px;
            border-radius: 8px;
            object-fit: cover;
            background: #2e2e2e;
            display: block;
        }

        .item-details {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .item-name {
            font-size: 16px;
            font-weight: 500;
            color: #f0f0f0;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .item-descr {
            font-size: 13px;
            color: #666;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .item-meta {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-top: 4px;
            flex-wrap: wrap;
        }

        .item-qty {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #555;
        }

            .item-qty span {
                color: #ccc;
                font-weight: 500;
            }

        .item-price {
            font-size: 15px;
            font-weight: 500;
            color: darkorange;
        }

        /* Notification */
        .notification {
            display: none;
            position: fixed;
            top: 20px;
            right: 20px;
            background: #242424;
            border: 1px solid #4caf50;
            color: #4caf50;
            padding: 14px 20px;
            border-radius: 10px;
            font-size: 14px;
            z-index: 1000;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
            transition: opacity 0.5s ease;
        }

            .notification.fade-out {
                opacity: 0;
            }

        @@media (max-width: 560px) {
            .order-item {
                flex-wrap: wrap;
            }

            .item-image img {
                width: 70px;
                height: 70px;
            }
        }
    </style>
</head>
<body>

    <div id="notification" class="notification"></div>

    <div class="page">
        <div class="page-title">EcomGalaxy</div>

        <div class="page-header">
            <div class="page-heading">Order #@ViewBag.OrderId</div>
            <a class="back-btn"
               asp-action="CustomerOrders"
               asp-controller="Order">
                ← Back to Orders
            </a>
        </div>

        <div class="card">
            @foreach (var item in Model)
            {
                <div class="order-item">
                    <div class="item-image">
                        <img src="/images/@item.ProductImage" alt="@item.ProductName">
                    </div>
                    <div class="item-details">
                        <div class="item-name">@item.ProductName</div>
                        <div class="item-descr">@item.ProductDescription</div>
                        <div class="item-meta">
                            <div class="item-qty">Qty: <span>@item.Quantity</span></div>
                            <div class="item-price">@item.TotalPrice EGP</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <script>
        function showNotification(message) {
            var n = document.getElementById('notification');
            n.textContent = message;
            n.style.display = 'block';
            setTimeout(function () {
                n.classList.add('fade-out');
                setTimeout(function () {
                    n.style.display = 'none';
                    n.classList.remove('fade-out');
                }, 500);
            }, 5000);
        }

        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["Notification"] != null)
            {
                    <text>showNotification('@TempData["Notification"]');</text>
            }
        });
    </script>
</body>
</html>
