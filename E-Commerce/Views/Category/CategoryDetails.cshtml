@model Category
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Name — Category Details</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: #1a1a1a;
            font-family: inherit;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            color: #f0f0f0;
        }

        .page {
            width: 100%;
            max-width: 900px;
        }

        /* Breadcrumb */
        .breadcrumb {
            font-size: 12px;
            color: #555;
            margin-bottom: 28px;
            letter-spacing: 0.04em;
        }

            .breadcrumb a {
                color: #555;
                text-decoration: none;
            }

                .breadcrumb a:hover {
                    color: darkorange;
                }

            .breadcrumb span {
                margin: 0 6px;
            }

        /* Card */
        .card {
            background: #242424;
            border-radius: 12px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
            border: 1px solid #333;
        }

        /* Image panel */
        .photo {
            background: #2e2e2e;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 36px;
            min-height: 420px;
        }

            .photo img {
                max-width: 100%;
                max-height: 300px;
                object-fit: contain;
                border-radius: 8px;
                display: block;
            }

        /* Info panel */
        .description {
            padding: 48px 44px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 20px;
        }

        .info-top {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .badge {
            display: inline-block;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            background: #2a1a00;
            color: darkorange;
            border: 1px solid #4a3000;
            padding: 4px 10px;
            border-radius: 20px;
            width: fit-content;
        }

        .category-name {
            font-size: 28px;
            font-weight: 500;
            color: #f0f0f0;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            line-height: 1.25;
        }

        .divider {
            height: 1px;
            background: #333;
        }

        .meta-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .meta-item {
            background: #1e1e1e;
            border-radius: 10px;
            padding: 12px 14px;
            border: 1px solid #2e2e2e;
        }

            .meta-item .label {
                font-size: 10px;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: #555;
                margin-bottom: 4px;
            }

            .meta-item .value {
                font-size: 14px;
                font-weight: 500;
                color: #ccc;
            }

        /* Actions */
        .actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 24px;
            border-radius: 10px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.25s ease;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border: 1px solid #444;
            background: none;
            text-decoration: none;
        }

        .btn-row {
            display: flex;
            gap: 10px;
        }

            .btn-row .btn {
                flex: 1;
            }

        .btn-edit {
            color: #ccc;
        }

            .btn-edit:hover {
                border-color: darkorange;
                color: darkorange;
            }

        .btn-back {
            color: #666;
        }

            .btn-back:hover {
                border-color: #666;
                color: #ccc;
            }

        .btn-delete {
            color: #b84040;
            border-color: #4a2a2a;
            width: 100%;
        }

            .btn-delete:hover {
                border-color: #b84040;
                background: #2a1a1a;
            }

        @@media (max-width: 700px) {
            .card {
                grid-template-columns: 1fr;
            }

            .photo {
                min-height: 260px;
            }

            .description {
                padding: 32px 28px;
            }

            .category-name {
                font-size: 22px;
            }
        }
    </style>
</head>
<body>
    <div class="page">

        <div class="breadcrumb">
            <a asp-action="ManageCategories" asp-controller="Category">Categories</a>
            <span>›</span>
            @Model.Name
        </div>

        <div class="card">

            <!-- Image -->
            <div class="photo">
                <img src="/images/@Model.CategoryImage" alt="@Model.Name">
            </div>

            <!-- Info -->
            <div class="description">
                <div class="info-top">
                    <span class="badge">Category</span>

                    <h1 class="category-name">@Model.Name</h1>

                    <div class="divider"></div>

                    <div class="meta-grid">
                        <div class="meta-item">
                            <div class="label">Category ID</div>
                            <div class="value">#@Model.Id</div>
                        </div>
                        
                    </div>
                </div>

                <!-- Actions -->
                <div class="actions">
                    <div class="btn-row">
                        <a class="btn btn-edit"
                           asp-action="UpdateCategory"
                           asp-controller="Category"
                           asp-route-id="@Model.Id">
                            ✏ Edit Category
                        </a>
                        <a class="btn btn-back"
                           asp-action="ManageCategories"
                           asp-controller="Category">
                            ← Back
                        </a>
                    </div>

                    <form asp-action="DeleteCategory"
                          asp-controller="Category"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to delete this category?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-delete">🗑 Delete Category</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</body>
</html>
