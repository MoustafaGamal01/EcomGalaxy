@model Product
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Name</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: #1a1a1a;
            font-family: inherit;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .page {
            width: 100%;
            max-width: 900px;
        }

        .card {
            background: #242424;
            border-radius: 12px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
            border: 1px solid #333;
        }

        /* Gallery */
        .photo {
            background: #2e2e2e;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px 36px 24px;
            gap: 20px;
            min-height: 460px;
        }

        .gallery-main {
            width: 100%;
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            border-radius: 8px;
            overflow: hidden;
        }

        .photo img {
            max-width: 100%;
            max-height: 280px;
            object-fit: contain;
            transition: opacity 0.3s ease, transform 0.3s ease;
            display: block;
        }

            .photo img.fade {
                opacity: 0;
                transform: scale(0.97);
            }

        .arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #1a1a1a;
            border: 1px solid #444;
            color: #ccc;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            transition: all 0.2s;
            z-index: 5;
        }

            .arrow:hover {
                background: darkorange;
                border-color: darkorange;
                color: white;
            }

        .arrow-left {
            left: 8px;
        }

        .arrow-right {
            right: 8px;
        }

        .thumbnails {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .thumb {
            width: 48px;
            height: 48px;
            border-radius: 6px;
            overflow: hidden;
            border: 2px solid transparent;
            cursor: pointer;
            transition: border-color 0.2s;
            background: #1a1a1a;
        }

            .thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .thumb.active {
                border-color: darkorange;
            }

        .img-counter {
            font-size: 11px;
            color: #666;
            letter-spacing: 0.08em;
        }

        /* Description */
        .description {
            padding: 48px 44px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 20px;
        }

        .info-top {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .product-name {
            font-size: 26px;
            font-weight: 500;
            color: #f0f0f0;
            line-height: 1.3;
            text-transform: uppercase;
        }

        .product-price {
            font-size: 28px;
            font-weight: 500;
            color: darkorange;
        }

            .product-price span {
                font-size: 14px;
                color: #666;
                font-weight: 400;
                margin-left: 4px;
            }

        .divider {
            height: 1px;
            background: #333;
        }

        .section-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #555;
            font-weight: 500;
            margin-bottom: 6px;
        }

        .product-description {
            font-size: 14px;
            line-height: 1.75;
            color: #888;
        }

        /* Actions */
        .actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 24px;
            border-radius: 10px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            text-decoration: none;
            border: 1px solid #444;
            letter-spacing: 0.04em;
            background: none;
        }

        .btn-row {
            display: flex;
            gap: 10px;
        }

            .btn-row .btn {
                flex: 1;
            }

        .btn-edit {
            color: #ccc;
        }

            .btn-edit:hover {
                border-color: darkorange;
                color: darkorange;
            }

        .btn-back {
            color: #666;
        }

            .btn-back:hover {
                border-color: #666;
                color: #ccc;
            }

        .btn-delete {
            color: #b84040;
            border-color: #4a2a2a;
            width: 100%;
        }

            .btn-delete:hover {
                border-color: #b84040;
                background: #2a1a1a;
            }

        @@media (max-width: 700px) {
            .card {
                grid-template-columns: 1fr;
            }

            .photo {
                min-height: 280px;
            }

            .description {
                padding: 32px 28px;
            }

            .product-name {
                font-size: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="card">

            <!-- Gallery -->
            <div class="photo">
                <div class="gallery-main">
                    <button class="arrow arrow-left" onclick="changeImage(-1)" aria-label="Previous">&#9664;</button>
                    <img id="productImage"
                         src="/images/@(Model.ProductImagePath?.FirstOrDefault() ?? "placeholder.jpg")"
                         alt="@Model.Name">
                    <button class="arrow arrow-right" onclick="changeImage(1)" aria-label="Next">&#9654;</button>
                </div>

                <div class="thumbnails" id="thumbnails"></div>
                <div class="img-counter" id="imgCounter"></div>
            </div>

            <!-- Info -->
            <div class="description">
                <div class="info-top">
                    <h2 class="product-name">@Model.Name</h2>
                    <div class="product-price">@Model.Price <span>EGP</span></div>
                    <div class="divider"></div>
                    <div>
                        <div class="section-label">Description</div>
                        <p class="product-description">@Model.Description</p>
                    </div>
                </div>

                <div class="actions">
                    <div class="btn-row">
                        <a class="btn btn-edit"
                           asp-action="UpdateProduct"
                           asp-controller="Product"
                           asp-route-id="@Model.Id">
                            ✏ Edit Product
                        </a>
                        <a class="btn btn-back"
                           asp-action="ProductsForSeller"
                           asp-controller="Product">
                            ← Back
                        </a>
                    </div>

                    <form asp-action="DeleteProduct"
                          asp-controller="Product"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to delete this product?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-delete">🗑 Delete Product</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <script>
        const images = @Html.Raw(Json.Serialize(Model.ProductImagePath ?? new List<string>()));
        let currentIndex = 0;

        const imgEl     = document.getElementById('productImage');
        const thumbsEl  = document.getElementById('thumbnails');
        const counterEl = document.getElementById('imgCounter');

        function buildThumbnails() {
            if (images.length <= 1) return;
            images.forEach((src, i) => {
                const div = document.createElement('div');
                div.className = 'thumb' + (i === 0 ? ' active' : '');
                div.onclick = () => goTo(i);
                const img = document.createElement('img');
                img.src = '/images/' + src;
                img.alt = 'Thumb ' + (i + 1);
                div.appendChild(img);
                thumbsEl.appendChild(div);
            });
        }

        function updateCounter() {
            counterEl.textContent = images.length > 1
                ? (currentIndex + 1) + ' / ' + images.length : '';
        }

        function goTo(index) {
            currentIndex = (index + images.length) % images.length;
            imgEl.classList.add('fade');
            setTimeout(() => {
                imgEl.src = '/images/' + images[currentIndex];
                imgEl.classList.remove('fade');
            }, 180);
            document.querySelectorAll('.thumb').forEach((t, i) =>
                t.classList.toggle('active', i === currentIndex));
            updateCounter();
        }

        function changeImage(dir) { goTo(currentIndex + dir); }

        buildThumbnails();
        updateCounter();
    </script>
</body>
</html>
